APP_NAME=ToWork
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=v1

# The Vue SPA (used for links in e-mails) and allowed CORS origins (comma separated, or *).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite out of the box. Docker uses MySQL (see compose.yaml).
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=towork
# DB_USERNAME=towork
# DB_PASSWORD=secret

# The API is stateless (Sanctum bearer tokens); sessions are only used by the web routes.
SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: "log" writes e-mails (verification / reset codes, reminders) to storage/logs.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@towork.test"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum token lifetime in minutes (empty = never expires).
SANCTUM_EXPIRATION=
