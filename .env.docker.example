# Optional overrides for `docker compose` (copy the lines you need into .env or export them).
# All defaults work out of the box for local use.
TOWORK_APP_PORT=8000
TOWORK_APP_URL=http://localhost:8000
TOWORK_FRONTEND_URL=http://localhost:3000
TOWORK_CORS_ALLOWED_ORIGINS=*
# Leave empty to auto-generate one on first start (kept in the storage volume).
TOWORK_APP_KEY=
TOWORK_APP_ENV=production
TOWORK_APP_DEBUG=false
TOWORK_LOG_LEVEL=info
TOWORK_SEED_DEMO=true

TOWORK_DB_DATABASE=towork
TOWORK_DB_USERNAME=towork
TOWORK_DB_PASSWORD=secret
TOWORK_DB_ROOT_PASSWORD=root-secret

# Use a real SMTP server instead of Mailpit:
TOWORK_MAIL_HOST=mailpit
TOWORK_MAIL_PORT=1025
TOWORK_MAIL_USERNAME=
TOWORK_MAIL_PASSWORD=
TOWORK_MAIL_FROM_ADDRESS=hello@towork.test
TOWORK_MAILPIT_PORT=8025
